# Optional: enable the Tonality engine (the transport's "⏻ Start engine" button).
# The app runs fully WITHOUT this — explorer, Chord Anatomy, playback, and the local
# analyzer all work with no Python. Set this only to turn on engine-backed analysis.
#
# Copy to .env.local (gitignored) and point at your Tonality checkout:
#   cp .env.example .env.local
TONALITY_DIR=/absolute/path/to/Tonality

# Overrides (optional):
# TONALITY_PYTHON=/custom/python      # defaults to $TONALITY_DIR/.venv/bin/python
# TONALITY_PORT=8012                  # bridge loopback port
